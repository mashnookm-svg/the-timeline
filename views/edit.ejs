<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Timeline</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>
<body>
  <div class="container py-4">
    <h1 class="mb-4">Timeline</h1>
    <h2 class="h4">Edit a Post</h2>

    <form action="/edit/<%= post._id %>" method="POST">
      <textarea name="post" class="form-control mb-2" rows="5"><%= post.post %></textarea>

      <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>

      <button type="submit" class="btn btn-primary">Submit</button>
      <a href="/<%= post._id %>" class="btn btn-secondary">Cancel</a>
    </form>
  </div>
</body>
</html>