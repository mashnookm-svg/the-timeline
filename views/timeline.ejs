<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Timeline</title>
</head>
<body>
  <h1>Timeline</h1>

  <% posts.forEach(function (post) { %>
    <div class="post">
      <h3><%= post.name %> - <%= post.date %></h3>
      <p><%= post.message %></p>
    </div>
  <% }) %>
</body>
</html>