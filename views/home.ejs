<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Timeline</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>
<body>
  <div class="container py-4">
    <h1 class="mb-4">Timeline</h1>

    <form action="/" method="POST" class="mb-5">
      <label for="post" class="form-label">Post a message</label>
      <textarea id="post" name="post" class="form-control mb-2" rows="4"><%= oldText %></textarea>

      <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>

      <button type="submit" class="btn btn-primary">Post a message</button>
    </form>

    <% if (posts.length === 0) { %>
      <p class="text-muted">No posts yet. Write the first one!</p>
    <% } %>

    <% posts.forEach(function (item) { %>
      <div class="border rounded p-3 mb-3">
        <small class="text-muted"><%= formatDate(item.createdAt) %></small>
        <p class="mb-2"><%= item.post.length > 100 ? item.post.slice(0, 100) + "..." : item.post %></p>
        <a href="/<%= item._id %>">See More</a>
      </div>
    <% }) %>
  </div>
</body>
</html>